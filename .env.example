# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Comma-separated list of allowed hostnames (only used when DEBUG=False)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins (only used when DEBUG=False)
# Vite dev server runs on 5173, Docker frontend on 3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Leave DB_NAME empty to use SQLite (for local development only)
DB_NAME=repair_db
DB_USER=repair_user
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=db
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
# Leave unset to use in-memory cache (single-process dev only)
REDIS_URL=redis://localhost:6379

# ── External APIs ────────────────────────────────────────────────────────────
DGIS_API_KEY=your-2gis-api-key-here

# ── Sentry ───────────────────────────────────────────────────────────────────
# Leave unset to disable error tracking
SENTRY_DSN=https://3e72d4cc17db8f61d1101b4059118ec5@o4511365135597568.ingest.de.sentry.io/4511365141299280

# ── Grafana ───────────────────────────────────────────────────────────────────
# Default admin credentials for the Grafana UI (http://localhost:3000)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
